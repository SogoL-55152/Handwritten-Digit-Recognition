# PUBLIC operator fields are compiled into the website and mini-program.
# Copy to a local ignored .env.pilot; never commit real secrets.
PILOT_OPERATOR=
PILOT_CONTACT=
PILOT_PRIVACY_VERSION=
PILOT_RECOGNITION_PER_MINUTE=10
# Server only: 16-256 random characters. Empty value deliberately closes admission.
PILOT_REGISTRATION_CODE=
MYSQL_DATABASE=hdr_pilot_app
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
V2_JWT_SECRET=
MODEL_INTERNAL_TOKEN=
MODEL_CHECKPOINT_PATH=
WEB_PORT=8088
# TLS certificate/domain and authorized WeChat AppID are separate prerequisites.
# No invented AppID, code, token or certificate is supplied here.
