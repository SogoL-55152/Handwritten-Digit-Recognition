# W2 Compose template. 一般不用手动复制：start.sh / start.bat 会自动生成 .env（随机密钥）。
# 手动部署时才复制为 .env 并填写。
# Blank mandatory values deliberately make Compose fail closed.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hdr_w2
DB_PASSWORD=
V2_JWT_SECRET=
MODEL_INTERNAL_TOKEN=
# Absolute host path to the verified W1 full checkpoint, mounted read-only.
MODEL_WEIGHTS_DIR=
WEB_PORT=8088
W2_MAX_WORKSPACES=3
W2_RECOGNITION_PER_MINUTE=60
# Platform-wide recognition cap per minute (previously hard-coded to 240 in RecognitionService).
W2_GLOBAL_RECOGNITION_PER_MINUTE=240
# Experimental acceptance thresholds; not a calibrated digit-validity probability.
RECOGNITION_MIN_CONFIDENCE=0.90
RECOGNITION_MIN_MARGIN=0.85
# Reserved budgets only: no member invitation or enforced daily ledger in W2.
W2_MAX_MEMBERS=5
W2_DAILY_RECOGNITION_LIMIT=1000
# Only 127.0.0.1:8088 is published. MySQL/Redis/Java/Python have no host ports.

# Bootstrap SUPER_ADMIN for an empty database (see deploy runbook 1.6). Leave blank to skip.
HDR_BOOTSTRAP_ADMIN_USERNAME=
HDR_BOOTSTRAP_ADMIN_PASSWORD=
# Register rate limit per IP (default 5 per 900s). Raise only for load tests.
W2_REGISTER_PER_IP=5
W2_REGISTER_WINDOW_SECONDS=900
