# W2 Compose template: copy to .env, fill locally, never commit real credentials.
# Blank mandatory values deliberately make Compose fail closed.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hdr_w2
DB_PASSWORD=
V2_JWT_SECRET=
MODEL_INTERNAL_TOKEN=
# Absolute host path to the verified W1 full checkpoint, mounted read-only.
MODEL_WEIGHTS_DIR=
WEB_PORT=8088
W2_MAX_WORKSPACES=3
W2_RECOGNITION_PER_MINUTE=60
# Experimental acceptance thresholds; not a calibrated digit-validity probability.
RECOGNITION_MIN_CONFIDENCE=0.90
RECOGNITION_MIN_MARGIN=0.85
# Reserved budgets only: no member invitation or enforced daily ledger in W2.
W2_MAX_MEMBERS=5
W2_DAILY_RECOGNITION_LIMIT=1000
# Only 127.0.0.1:8088 is published. MySQL/Redis/Java/Python have no host ports.
