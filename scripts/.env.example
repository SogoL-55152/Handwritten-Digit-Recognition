# 本机 PowerShell 起停脚本的环境模板（Docker Compose 用的是仓库根目录的 .env.example，两者互不影响）
# 用法：复制为 scripts/.env 后按本机实际情况修改；scripts/.env 被 .gitignore 忽略，不会入库。
#   Copy-Item scripts/.env.example scripts/.env
# 启动：powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1
# 停止：powershell -ExecutionPolicy Bypass -File scripts/stop-all.ps1
# 说明：所有键都可不填，脚本会退回内置默认值；但只要机器路径不同就必须改 *_EXE 与 *_HOME 系列。

# ===== 运行时目录（日志、PID、MySQL 数据目录都放这里）=====
HDR_RUNTIME=D:\HDR-runtime

# ===== 可执行文件路径 =====
JAVA_HOME=D:\hdr-verify-tools\jdk-17.0.21.1+2
MAVEN_BIN=D:\hdr-verify-tools\apache-maven-3.9.9\bin\mvn.cmd
MAVEN_SETTINGS=D:\hdr-verify-tools\settings.xml
PYTHON=D:\Anaconda3\python.exe
NODE=D:\nodejs\node.exe

MYSQLD_EXE=D:\MySQL9\bin\mysqld.exe
MYSQLADMIN_EXE=D:\MySQL9\bin\mysqladmin.exe
MYSQL_BASEDIR=D:\MySQL9
MYSQL_DATADIR=D:\HDR-runtime\mysql\data
MYSQL_PORT=13316

REDIS_SERVER_EXE=D:\HDR-runtime\redis\redis-server.exe
REDIS_CLI_EXE=D:\HDR-runtime\redis\redis-cli.exe
REDIS_PORT=16379

# ===== 端口 =====
SERVER_PORT=8080
MODEL_PORT=5001
WEB_PORT=5173

# ===== 业务后端 =====
SPRING_PROFILES_ACTIVE=default
HDR_PILOT_ENABLED=false
HDR_LEGACY_AUTH_ENABLED=false
HDR_LEGACY_BOOTSTRAP_ENABLED=false
DB_URL=jdbc:mysql://127.0.0.1:13316/hdr_w2?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=hdr
DB_PASSWORD=change-me-app-password
# JWT 签名密钥：至少 32 字节，部署到测试机/生产前必须换成随机值
V2_JWT_SECRET=change-me-32-bytes-minimum-secret-key
JWT_SECRET=change-me-legacy-secret-key

# ===== 后端 ↔ 模型服务内部认证（三个进程必须一致）=====
MODEL_INTERNAL_TOKEN=change-me-internal-token
MODEL_SERVICE_URL=http://127.0.0.1:5001

# ===== Redis（REDIS_URL 与 REDIS_HOST/PORT 都要给，只给 URL 会导致日志接口空返回）=====
REDIS_URL=redis://127.0.0.1:16379/0
REDIS_HOST=127.0.0.1

# ===== 模型服务 =====
WEIGHTS_DIR=D:\Handwritten-Digit-Recognition-develop\Handwritten-Digit-Recognition-develop\model-service\weights
MODEL_REGISTRY_PATH=D:\Handwritten-Digit-Recognition-develop\Handwritten-Digit-Recognition-develop\model-service\weights\registry.json
RECOGNITION_MIN_CONFIDENCE=0.90
RECOGNITION_MIN_MARGIN=0.85
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
HDR_PREPROCESS_DESPECKLE=1
HDR_PREPROCESS_UPSCALE=1

# ===== 运行期数据目录（都在仓库内，已被 .gitignore 忽略）=====
HDR_COLLECTED_DIR=D:\Handwritten-Digit-Recognition-develop\Handwritten-Digit-Recognition-develop\collected-samples
HDR_RECOGNITION_DIR=D:\Handwritten-Digit-Recognition-develop\Handwritten-Digit-Recognition-develop\recognition-images
HDR_TRAINING_DATA_DIR=D:\Handwritten-Digit-Recognition-develop\Handwritten-Digit-Recognition-develop\training-data

# ===== 训练 worker =====
TRAINING_CALLBACK_URL=http://127.0.0.1:8080
TRAINING_DATA_DIR=D:\Handwritten-Digit-Recognition-develop\Handwritten-Digit-Recognition-develop\model-service\data\MNIST\raw
TRAINING_THREADS=2
TRAINING_LEASE_SECONDS=30

# ===== 数据集导入 =====
# 允许导入的根目录（分号分隔多个），不配 C:\ 会导致 C 盘目录导入被拒
HDR_IMPORT_ROOT=D:\;C:\
HDR_IMPORT_PYTHON=D:\Anaconda3\python.exe
HDR_IMPORT_SCRIPT=model-service/tools/svhn_import.py

# ===== 备份/恢复演练用的管理员账号（db-backup-restore.ps1 需要建/删临时库）=====
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change-me-root-password

# ===== 识别限流（每分钟）=====
# 每用户上限
W2_RECOGNITION_PER_MINUTE=60
# 全平台上限（历史上写死在 RecognitionService，现改为可配置）
W2_GLOBAL_RECOGNITION_PER_MINUTE=240

# ===== 空库引导管理员（可选；两个都填才生效，建完请立即改密码并移除）=====
HDR_BOOTSTRAP_ADMIN_USERNAME=
HDR_BOOTSTRAP_ADMIN_PASSWORD=
# ===== 注册接口按 IP 的配额（默认 5 次/15 分钟；只在压测环境放大）=====
W2_REGISTER_PER_IP=5
W2_REGISTER_WINDOW_SECONDS=900
