HOST=127.0.0.1
PORT=5001
# Required for both internal/v2 endpoints. Inject a long random shared token locally.
MODEL_INTERNAL_TOKEN=
# Administrator-controlled file path; default weights/w1-full/checkpoint.pt under service root.
# MODEL_CHECKPOINT_PATH=/absolute/path/to/checkpoint.pt
# Set before Python startup to bound CPU threads (2 inference slots per process).
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
# Experimental acceptance policy (not a calibrated OOD probability).
RECOGNITION_MIN_CONFIDENCE=0.90
RECOGNITION_MIN_MARGIN=0.85
