<view class="page">
  <view class="header">
    <view class="header-title">
      <view class="title">手写数字识别</view>
      <view class="subtitle">书写或导入一张单个数字图片</view>
    </view>
    <button wx:if="{{authorized}}" class="logout" bindtap="logout">退出</button>
  </view>
  <view class="error" wx:if="{{configurationError}}">{{configurationError}}</view>
  <view class="links">
    <button bindtap="openAccount">账号</button>
    <button bindtap="openHelp">帮助</button>
    <button bindtap="openPrivacy">隐私</button>
  </view>
  <view class="card" wx:if="{{loading}}">正在加载…</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button wx:if="{{error && !configurationError}}" bindtap="onShow">重试</button>
  <view wx:if="{{authorized}}">
    <view class="card" wx:if="{{!pilot}}">
      <view class="welcome">欢迎，{{user.nickname || user.username}}</view>
      <picker range="{{workspaces}}" range-key="name" value="{{workspaceIndex}}" bindchange="onWorkspaceChange" disabled="{{!workspaces.length}}">
        <view class="workspace">{{workspace ? workspace.name : '请选择空间'}} · 点击切换</view>
      </picker>
      <view class="note" wx:if="{{spaceLoading}}">正在切换…</view>
    </view>
    <view wx:if="{{workspaceReady}}">
      <view class="input-modes">
        <button id="drawing-mode" class="mode-button {{inputKind === 'drawing' ? 'selected' : ''}}" data-kind="drawing" bindtap="onInputKindChange">手写数字</button>
        <button id="image-mode" class="mode-button {{inputKind === 'image' ? 'selected' : ''}}" data-kind="image" bindtap="onInputKindChange">导入图片</button>
      </view>
      <view hidden="{{inputKind !== 'drawing'}}">
        <drawing-board id="business-board" simple="{{true}}" bind:change="onDrawingChange" />
      </view>
      <view class="card image-input" wx:if="{{inputKind === 'image'}}">
        <view class="note">从相册选择一张 PNG / JPEG，只包含一个 0–9 数字。单张最多 5 MiB，最长边 2048 像素。</view>
        <button id="choose-image" class="image-button" bindtap="chooseImage">{{imageBusy ? '重新选择图片' : imagePath ? '更换图片' : '从相册选择'}}</button>
        <view class="note" wx:if="{{imageBusy}}">正在选择或检查图片…</view>
        <image id="import-preview" wx:if="{{imagePath}}" class="image-preview" src="{{imagePath}}" mode="aspectFit" />
        <view class="note" wx:if="{{imageInfo}}">{{imageInfo.type}} · {{imageInfo.width}} × {{imageInfo.height}} 像素 · {{imageInfo.sizeKiB}} KiB</view>
        <button id="remove-image" wx:if="{{imagePath || imageBusy}}" class="image-button secondary" bindtap="removeImage">移除图片</button>
        <view class="error" wx:if="{{imageError}}">{{imageError}}</view>
        <view class="note">选择后仅预览，点击“识别图片”才上传。不扫描相册，不使用相机。</view>
      </view>
      <view class="multi-row">
        <switch checked="{{multiEnabled}}" bindchange="onMultiToggle" />
        <picker range="{{[1,2,3,4]}}" value="{{multiDigits - 1}}" bindchange="onDigitsChange">
          <view class="note">最多 {{multiDigits}} 位数字</view>
        </picker>
      </view>
      <view class="note" wx:if="{{multiEnabled}}">先在画板写 1–4 个间隔的数字，或导入这样的图片，再点下方的多位数识别。</view>
      <button id="recognize-input" class="recognize" bindtap="recognize" loading="{{recognizing}}" disabled="{{recognizing || (inputKind === 'image' ? (!imagePath || imageBusy) : !hasInk)}}">{{recognizing ? '正在识别…' : inputKind === 'image' ? '识别图片' : '识别这个数字'}}</button>
      <view class="note">每次只识别一个数字。请使用白底黑字、清晰且适当留白的图片。</view>
      <view class="error" wx:if="{{recognitionError}}">{{recognitionError}}</view>
      <view class="note">多位数：切分后逐字识别整串，不认连笔；结果会写入识别历史。</view>
      <button wx:if="{{multiEnabled}}" id="recognize-multi" class="recognize" bindtap="recognizeMulti" loading="{{multiBusy}}" disabled="{{multiBusy || (inputKind === 'image' ? (!imagePath || imageBusy) : !hasInk)}}">{{multiBusy ? '正在识别…' : '识别多位数字'}}</button>
      <view class="error" wx:if="{{multiError}}">{{multiError}}</view>
      <view class="card result" wx:if="{{multiResult}}">
        <view class="welcome">识别结果：{{multiResult.text}}</view>
        <view class="digit-chips">
          <text wx:for="{{multiResult.digits}}" wx:key="position" class="chip {{item.low ? 'low' : ''}}">{{item.position}}: {{item.digit}} ({{item.confidencePercent}}%)</text>
        </view>
        <view class="note" wx:if="{{multiResult.lowCount}}">有 {{multiResult.lowCount}} 位置信度低于 90%，建议重写。</view>
        <view class="note">记录 #{{multiResult.recognitionId}} · 模型 {{multiResult.modelVersion}}</view>
      </view>
      <view class="card result" wx:if="{{result}}">
        <view class="welcome">识别数字：{{result.digit}}</view>
        <view>置信度：{{result.confidencePercent}}%</view>
        <view>耗时：{{result.processingMs}} ms</view>
        <view class="note">置信度是本次预测的评分，不是整体准确率。</view>
      </view>
    </view>
  </view>
</view>
