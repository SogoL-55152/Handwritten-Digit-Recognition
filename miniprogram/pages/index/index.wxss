.page { min-height: 100vh; padding: 36rpx 32rpx 60rpx; }
.header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; margin-bottom: 28rpx; }
.header-title { flex: 1; min-width: 0; }
.title { font-size: 40rpx; font-weight: 600; }
.subtitle { margin-top: 8rpx; font-size: 26rpx; color: #606b7d; }
.logout { flex-shrink: 0; width: 104rpx; height: 64rpx; min-height: 64rpx; margin: 0; padding: 0 16rpx; display: flex; align-items: center; justify-content: center; line-height: 1.2; font-size: 26rpx; color: #374151; background: #ffffff; border-radius: 14rpx; }
.logout::after { border: none; }
.card { margin-bottom: 24rpx; padding: 32rpx; background: #ffffff; border-radius: 24rpx; }
.welcome { font-size: 34rpx; font-weight: 600; color: #1f2d3d; }
.workspace { padding: 24rpx 0; color: #2345c4; font-size: 28rpx; }
.note { margin: 16rpx 0 24rpx; font-size: 24rpx; line-height: 1.7; color: #606b7d; }
.recognize { width: 100%; height: 92rpx; min-height: 92rpx; margin: 24rpx 0 0; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; text-align: center; line-height: 1.2; font-size: 30rpx; font-weight: 500; border-radius: 16rpx; background: #2f54eb; color: #ffffff; }
.recognize::after { border: none; }
.recognize[disabled] { background: #c4cde5; color: #ffffff; }
.error { margin: 24rpx 0; color: #a12622; font-size: 26rpx; line-height: 1.7; }
.result { font-size: 26rpx; line-height: 1.9; overflow-wrap: anywhere; }
.links { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.links button { flex: 1; font-size: 26rpx; }
