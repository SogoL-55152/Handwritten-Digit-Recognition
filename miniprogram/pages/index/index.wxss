.page {
  min-height: 100vh;
  padding: 36rpx 36rpx 60rpx;
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a94a6;
}

.logout {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #7b8496;
  background: #ffffff;
  border-radius: 999rpx;
}

.placeholder {
  padding: 56rpx 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(31, 45, 61, 0.06);
}

.placeholder-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.placeholder-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #8a94a6;
}
