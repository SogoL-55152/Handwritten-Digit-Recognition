<view class="page">
  <view class="hero">
    <view class="brand">手写数字识别</view>
    <view class="headline">写一个数字，\n看看识别结果</view>
    <view class="subline">登录后开始书写和识别</view>
  </view>
  <view class="card">
    <view class="card-title">账号登录</view>
    <view class="error" wx:if="{{configurationError}}">{{configurationError}}</view>
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" value="{{username}}" data-field="username" maxlength="-1" disabled="{{loading}}" placeholder="请输入用户名" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password value="{{password}}" data-field="password" maxlength="-1" disabled="{{loading}}" placeholder="请输入密码" bindinput="onInput" />
    </view>
    <button class="btn" loading="{{loading}}" disabled="{{loading || configurationError}}" bindtap="submit">登录并开始</button>
    <button wx:if="{{hasCandidate}}" disabled="{{loading || configurationError}}" bindtap="continueSession">继续上次登录</button>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button disabled="{{loading}}" bindtap="openRegister">没有账号？注册</button>
  </view>
  <view class="links">
    <button bindtap="openHelp">使用帮助</button>
    <button bindtap="openPrivacy">隐私说明</button>
  </view>
</view>
