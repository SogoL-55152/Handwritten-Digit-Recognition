<view class="page">
  <view class="card">
    <view class="card-title">注册账号</view>
    <view class="error" wx:if="{{configurationError}}">{{configurationError}}</view>
    <view class="field"><text class="label">用户名 · 3–32 字符，不含空白</text><input class="input" maxlength="-1" value="{{username}}" disabled="{{loading}}" data-field="username" bindinput="onInput" placeholder="请输入用户名" /></view>
    <view class="field"><text class="label">密码 · 6–32 字符，不含空白</text><input class="input" password maxlength="-1" value="{{password}}" disabled="{{loading}}" data-field="password" bindinput="onInput" placeholder="请输入密码" /></view>
    <view class="field"><text class="label">确认密码</text><input class="input" password maxlength="-1" value="{{confirmation}}" disabled="{{loading}}" data-field="confirmation" bindinput="onInput" placeholder="请再次输入密码" /></view>
    <view class="field"><text class="label">昵称 · 可选，最多 64 字符</text><input class="input" maxlength="-1" value="{{nickname}}" disabled="{{loading}}" data-field="nickname" bindinput="onInput" placeholder="可留空" /></view>
    <view class="field"><text class="label">试用注册码{{pilot ? ' · 必填' : ' · 按维护者要求填写'}}</text><input class="input" password maxlength="-1" value="{{pilotCode}}" disabled="{{loading}}" data-field="pilotCode" bindinput="onInput" placeholder="由维护者提供" /></view>
    <view class="hint">注册前请阅读隐私说明。</view>
    <view class="error" wx:if="{{error}}">{{error}}</view>
    <button class="btn" bindtap="submit" loading="{{loading}}" disabled="{{loading || configurationError}}">注册并开始</button>
    <button bindtap="openLogin">已有账号，返回登录</button>
  </view>
  <view class="links"><button bindtap="openHelp">帮助</button><button bindtap="openPrivacy">隐私说明</button></view>
</view>
