# Default keeps all W2 developer routes. Use pilot for the small drawing/account experience.
VITE_APP_MODE=development
# Public display settings. Required for a pilot production build; use real operator details.
VITE_PILOT_OPERATOR=
VITE_PILOT_CONTACT=
VITE_PILOT_PRIVACY_VERSION=
# Never add registration codes, internal tokens or other secrets to VITE_* variables.
